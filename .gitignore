.env
.env.local
.env.*.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp
.cache/

# 系統監控的感測器 sidecar（C# 建置產物，36MB）
# 打包前跑 `npm run build:sensors` 產生；不進版控
native/sysmon-sensors/bin/
native/sysmon-sensors/obj/
resources/sensors/

# 語音輸入的熱鍵 sidecar（C# 建置產物，10MB）
# 打包前跑 `npm run build:hook` 產生；不進版控
native/dictation-hook/bin/
native/dictation-hook/obj/
resources/hook/

# 檔案總管的殼層 sidecar（右鍵 7-Zip／WinRAR、Google Drive 綠勾）
# 打包前跑 `npm run build:shell` 產生；不進版控
native/explorer-shell/bin/
native/explorer-shell/obj/
resources/shell/

# 系統監控取樣＋使用時長觀測（Rust，取代兩支常駐 PowerShell）
# 打包前跑 `npm run build:probe` 產生；沒建置會退回 PowerShell
native/voiceink-probe/target/
resources/probe/

# 指示器外觀檢查的截圖（scripts/probe-dictation-hud.js）
.tmp-hud/

# 打包用的臨時輸出（dist/win-unpacked 被別的程式鎖住時的替代路徑）
dist-hud/

# Claude Code 的工作區（worktrees 動輒好幾份，不進版控）
.claude/
