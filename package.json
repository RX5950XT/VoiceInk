{
  "name": "voiceink",
  "version": "1.12.0",
  "description": "VoiceInk - Windows Desktop Speech-to-Text Application",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:pack": "vite build && electron-builder --win dir",
    "electron:build": "vite build && electron-builder --publish never",
    "start": "electron .",
    "test:sysmon": "node scripts/test-sysmon.js",
    "build:sensors": "dotnet publish native/sysmon-sensors -c Release -o resources/sensors",
    "build:hook": "dotnet publish native/dictation-hook -c Release -o resources/hook"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "43.4.1",
    "electron-builder": "^26.0.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "monaco-editor": "^0.55.1",
    "node-edge-tts": "^1.2.10",
    "node-llama-cpp": "^3.19.0",
    "opencc-js": "^1.4.1",
    "pdfjs-dist": "6.3.289",
    "sherpa-onnx-node": "^1.13.4",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.voiceink.app",
    "productName": "VoiceInk",
    "directories": {
      "output": "dist"
    },
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty-*/**",
      "**/node_modules/sherpa-onnx-*/**",
      "**/node_modules/@node-llama-cpp/win-x64/**",
      "**/node_modules/@reflink/**",
      "**/node_modules/uiohook-napi/**",
      "src/main/usage/read-windows-credential.ps1",
      "src/main/sysmon/probe.ps1",
      "src/main/screentime/observer.ps1"
    ],
    "files": [
      "**/*",
      "!**/node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!**/node_modules/@node-llama-cpp/win-arm64/**",
      "!**/node_modules/node-llama-cpp/llama/**",
      "**/node_modules/node-llama-cpp/llama/binariesGithubRelease.json",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/pdfjs-dist/**",
      "**/node_modules/pdfjs-dist/package.json",
      "**/node_modules/pdfjs-dist/build/pdf.min.mjs",
      "**/node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "!**/node_modules/monaco-editor/**",
      "**/node_modules/monaco-editor/package.json",
      "**/node_modules/monaco-editor/min/**",
      "!dist/**",
      "!dist-*/**",
      "!tasks/**",
      "!native/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RX5950XT",
        "repo": "VoiceInk"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/sensors",
        "to": "sensors",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/hook",
        "to": "hook",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
